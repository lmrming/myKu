# ============================================
# MySQL 数据库配置
# ============================================
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=root
DB_NAME=myku_app

# ============================================
# Redis 配置
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis 集群配置（生产环境）
# REDIS_CLUSTER_HOST_1=redis-node-1
# REDIS_CLUSTER_HOST_2=redis-node-2
# REDIS_CLUSTER_HOST_3=redis-node-3

# Redis 哨兵配置（高可用）
# REDIS_SENTINEL_HOST_1=sentinel-1
# REDIS_SENTINEL_HOST_2=sentinel-2

# ============================================
# 服务器端口
# ============================================
PORT=3000

# ============================================
# 环境配置
# ============================================
NODE_ENV=development
# NODE_ENV=production
