{
  "name": "myku",
  "version": "2.0.0",
  "description": "my库 - 个人效率工具集，包含待办事项、日历、专注模式、备忘录、习惯追踪、天气和白噪音功能",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "vite",
    "dev:start": "node dev-start.js",
    "dev:config": "node dev-start.js --config",
    "dev:help": "node dev-start.js --help",
    "start:all": "start.bat",
    "stop:all": "stop.bat",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server-mysql.cjs",
    "server": "node server-mysql.cjs",
    "server:json": "node server-json.cjs",
    "test:redis": "node test-redis.cjs",
    "redis:start": "docker compose -f docker-compose.redis.yml up -d",
    "redis:stop": "docker compose -f docker-compose.redis.yml down",
    "redis:logs": "docker compose -f docker-compose.redis.yml logs -f"
  },
  "keywords": [
    "前端",
    "登录",
    "注册",
    "待办事项",
    "天气查询",
    "Node.js",
    "Express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@appletosolutions/reactbits": "^1.0.3",
    "@gsap/react": "^2.1.2",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lucide-react": "^1.6.0",
    "moment": "^2.30.1",
    "mysql2": "^3.22.1",
    "ogl": "^1.0.11",
    "postcss": "^8.4.38",
    "react": "^18.2.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^18.2.0",
    "react-is": "^19.2.6",
    "react-router-dom": "^6.20.0",
    "recharts": "^3.8.0",
    "redis": "^4.6.0",
    "tailwindcss": "^3.3.5",
    "vite": "^5.0.8"
  },
  "devDependencies": {
    "autocannon": "^8.0.0"
  }
}
